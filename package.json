{
  "name": "klik-games",
  "private": true,
  "version": "1.0.0",
  "description": "Klik Games \u2014 Instant Browser Gaming Portal featuring 99 Nights in the Forest and 15+ Original HTML5 Games",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:pages": "vite build --base=/Klik/",
    "test:pages": "npm run build:pages && node test/pages-build.mjs",
    "preview": "vite build && node scripts/make-standalone.mjs && node scripts/serve.mjs",
    "preview:vite": "vite preview --host 0.0.0.0 --port 4173",
    "serve": "node scripts/serve.mjs",
    "test": "vite-node test/smoke.tsx",
    "test:n99": "vite-node test/n99.tsx",
    "test:boot": "node test/browser-boot.mjs",
    "test:standalone": "npm run build && node scripts/make-standalone.mjs && node test/standalone-boot.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-node": "^6.0.0"
  }
}
